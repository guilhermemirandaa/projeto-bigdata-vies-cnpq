# Copie para .env (que NÃO vai para o Git) e preencha.
# Valor gerado por: terraform -chdir=terraform output -raw database_url
DATABASE_URL=postgres://usuario:senha@host:porta/defaultdb?sslmode=require

# Usado pelo Terraform (TF_VAR_ = variável do Terraform)
TF_VAR_aiven_api_token=seu_token_aqui
TF_VAR_aiven_project=seu_projeto_aiven
